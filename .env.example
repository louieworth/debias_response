# Copy only the needed entries into the ignored project-root .env.
# Never commit real credentials.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=

# DeepSeek official API. As of 2026-07-29 the official API no longer serves V3;
# deepseek-v4-flash is the closest low-cost non-thinking replacement.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local OpenAI-compatible vLLM endpoints.
LOCAL_VLLM_API_KEY=local
LLAMA_LOCAL_BASE_URL=http://127.0.0.1:8101/v1
MISTRAL_LOCAL_BASE_URL=http://127.0.0.1:8102/v1
LLAMA_LOCAL_SERVED_MODEL=llama-3.3-70B-instruct-turbo
MISTRAL_LOCAL_SERVED_MODEL=mistral-7B-instruct-v0.3

# Llama may be a gated Hugging Face repo and is not cached on this machine yet.
LLAMA_MODEL_PATH=meta-llama/Llama-3.3-70B-Instruct
MISTRAL_MODEL_PATH=/data2/.huggingface/hub/models--mistralai--Mistral-7B-Instruct-v0.3/snapshots/c170c708c41dac9275d15a8fff4eca08d52bab71

# Local serving defaults. Llama uses GPUs 0-3; Mistral uses GPU 4.
LLAMA_CUDA_VISIBLE_DEVICES=0,1,2,3
LLAMA_TENSOR_PARALLEL_SIZE=4
LLAMA_GPU_MEMORY_UTILIZATION=0.95
LLAMA_MAX_MODEL_LEN=16384
MISTRAL_CUDA_VISIBLE_DEVICES=4
MISTRAL_GPU_MEMORY_UTILIZATION=0.85
MISTRAL_MAX_MODEL_LEN=16384
